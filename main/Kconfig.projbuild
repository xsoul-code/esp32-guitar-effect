menu "WiFi Configuration"

    config ESP_WIFI_SSID
        string "WiFi SSID"
        default "myssid"
        help
            SSID (network name) to connect to.

    config ESP_WIFI_PASSWORD
        string "WiFi Password"
        default "mypassword"
        help
            WiFi password (WPA/WPA2) to use.

    config ESP_MAXIMUM_RETRY
        int "Maximum retry"
        default 5
        help
            Maximum number of retries to connect to the AP.

    config ESP_WIFI_AP_SSID
        string "Pedal WiFi name (SoftAP)"
        default "GuitarFX"
        help
            WiFi network created by the pedal, panel at http://192.168.4.1

    config ESP_WIFI_AP_PASSWORD
        string "Pedal WiFi password (SoftAP)"
        default "guitarfx"
        help
            WPA2 password, at least 8 characters. Empty = open network.

endmenu

menu "MQTT Configuration"

    config MQTT_BROKER_URI
        string "MQTT Broker URI"
        default "mqtt://192.168.1.100"
        help
            Full URI of the MQTT broker (e.g. mqtt://192.168.1.100 or mqtt://broker.local:1883).

endmenu